# Production Environment Configuration
# These values are injected at build time by Vite

# API URL - empty because CloudFront routes /api/* to API Gateway
# This allows the frontend to use relative paths like /api/auth/otp
VITE_API_URL=

# Note: The actual API Gateway URL is handled by CloudFront's CacheBehavior
# which routes /api/* requests to the API Gateway origin

# Cloudflare Turnstile site key — injected at build time by deploy script
VITE_TURNSTILE_SITE_KEY=
